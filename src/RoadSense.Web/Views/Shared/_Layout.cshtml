@{
    var current = ViewData["Page"] as string ?? "";
    string Active(string p) => p == current ? "nav__link is-active" : "nav__link";
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"RoadSense — {t}" : "RoadSense")</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@300;600;800&family=Onest:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="page-@current">
    @await RenderSectionAsync("TopBar", required: false)

    <header class="nav">
        <div class="nav__inner container">
            <a asp-controller="Home" asp-action="Index" class="brand" aria-label="RoadSense — начало">
                <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><circle cx="17" cy="17" r="15" fill="none" stroke="#FF3B30" stroke-width="2"></circle><circle cx="17" cy="17" r="8" fill="none" stroke="#FF3B30" stroke-width="1.5" opacity="0.6"></circle><path d="M17 17 L17 2 A15 15 0 0 1 30 10 Z" fill="#FF3B30" opacity="0.85"></path><circle cx="17" cy="17" r="2.5" fill="#D4F2DB"></circle></svg>
                <span class="brand__word">Road<span>Sense</span></span>
            </a>
            <nav aria-label="Основна навигация" class="nav__links">
                <a asp-controller="Home" asp-action="Index" class="@Active(Pages.Home)" aria-current="@(current == Pages.Home ? "page" : null)">Начало</a>
                <a asp-controller="Route" asp-action="Index" class="@Active(Pages.Route)" aria-current="@(current == Pages.Route ? "page" : null)">Маршрут</a>
                <a asp-controller="Weather" asp-action="Index" class="@Active(Pages.Weather)" aria-current="@(current == Pages.Weather ? "page" : null)">Времето около мен</a>
                <a asp-controller="Stats" asp-action="Index" class="@Active(Pages.Stats)" aria-current="@(current == Pages.Stats ? "page" : null)">Статистика</a>
                <a asp-controller="FirstAid" asp-action="Index" class="@Active(Pages.FirstAid)" aria-current="@(current == Pages.FirstAid ? "page" : null)">Първа помощ</a>
            </nav>
            @if (current == Pages.Home)
            {
                <a asp-controller="Route" asp-action="Index" class="btn btn--red press nav__cta">Провери маршрут</a>
            }
            else if (current == Pages.FirstAid)
            {
                <a href="tel:112" class="btn btn--red press nav__cta">Обади се на 112</a>
            }
            else
            {
                <a asp-controller="FirstAid" asp-action="Index" class="btn btn--outline-red press nav__cta">Спешно: 112</a>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer__inner">
            <span>© 2026 RoadSense · проект за хакатон · <span class="mono">версия 3 · 20.11</span></span>
            <span>Информацията е ориентировъчна. Винаги се съобразявай със знаците и реалните условия на пътя.</span>
        </div>
    </footer>

    <script src="~/js/core.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
